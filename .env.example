# RailSathi Environment Variables Template
# Copy this file to .env.local and fill in your API keys

# RailRadar Live Train Data API (https://railradar.in)
RAILRADAR_API_KEY=your_railradar_api_key_here

# MapTiler Vector Maps API (https://maptiler.com)
NEXT_PUBLIC_MAPTILER_API_KEY=your_maptiler_api_key_here

# OpenWeather API (https://openweathermap.org)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# OpenTopography SRTM Elevation API (https://opentopography.org)
OPENTOPOGRAPHY_API_KEY=your_opentopography_api_key_here

# Google Gemini AI API (https://ai.google.dev)
GEMINI_API_KEY=your_gemini_api_key_here
